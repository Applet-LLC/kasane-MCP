{
  "name": "kasane-mcp",
  "version": "0.1.4",
  "description": "MCP server for kasane (key remapper): answers from the installed manual and prepares settings files. It never writes to the driver or your settings.",
  "license": "Apache-2.0",
  "author": "Applet-LLC",
  "homepage": "https://github.com/Applet-LLC/kasane-MCP#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Applet-LLC/kasane-MCP.git" },
  "keywords": ["mcp", "model-context-protocol", "windows", "keyboard", "remap", "kasane"],
  "os": ["win32"],
  "type": "module",
  "bin": { "kasane-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=18" }
}
